public class Cliente {
    public static void main(String[] args) {
        Polinomio polinomio = new Polinomio(new int[] { 1, 2, 3 });
        Polinomio derivada = polinomio.derivar();

        System.out.print("Polinomio: ");
        polinomio.mostrarTerminos();
        System.out.println();
        
        System.out.print("Derivada: ");
        derivada.mostrarTerminos();
        System.out.println();
    }
}
